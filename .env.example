# Weekly newsletter. The dashboard build and the Monday send read different variables.
# Do not put API keys in web/.env.local — Next inlines every NEXT_PUBLIC_ value into the static site.

# --- Static site (web/.env.local, or the Vercel project, set before the build) ---
# buttondown (default) or resend
NEXT_PUBLIC_NEWSLETTER_PROVIDER=buttondown
# Buttondown username only. The form posts to Buttondown's embed endpoint.
NEXT_PUBLIC_BUTTONDOWN_USERNAME=
# Resend alternative: public URL of newsletter/resend POST /subscribe
NEXT_PUBLIC_SUBSCRIBE_ENDPOINT=

# --- Monday job (shell, GitHub Actions, or the n8n host). Not the static site. ---
NEWSLETTER_PROVIDER=buttondown
# Secret. GitHub Actions secret BUTTONDOWN_API_KEY. Sends with Authorization: Token <key>.
BUTTONDOWN_API_KEY=
# Absolute dashboard URL used inside the email. No trailing path required.
SITE_URL=http://127.0.0.1:43123
# Set to 1 to send. Anything else, including empty, is a dry run that only archives the issue.
NEWSLETTER_SEND=
# Set to 1 to force a dry run even when NEWSLETTER_SEND=1 or --send is passed.
NEWSLETTER_DRY_RUN=

# --- Resend alternative. Secret values stay on the function and the Monday job. ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
NEWSLETTER_FROM=
NEWSLETTER_CONFIRM_SECRET=
SUBSCRIBE_FUNCTION_URL=
