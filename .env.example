# Inflammation Signal Monitor. Public values may be baked into the static site.
# Secrets never use a NEXT_PUBLIC_ name.

# --- Static site (web/.env.local, or the Vercel project, set before the build) ---
# Supabase project URL and the anon key. The anon key is public. Row level security
# is what keeps the list private. The approve page uses it for the magic link.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Edge function origin, no trailing path. Example:
# https://<project-ref>.supabase.co/functions/v1
NEXT_PUBLIC_FUNCTIONS_BASE=
# Cloudflare Turnstile site key. The test key 1x00000000000000000000AA always passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Absolute origin of the dashboard, no path. Used as the magic-link return URL.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123
# 1 only on a local dry-run. Shows the confirmation link in the browser and skips
# the real magic-link email. Leave unset in production.
NEXT_PUBLIC_LOCAL_PREVIEW=

# --- Data pulls (Monday job). ---
OPENFDA_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=inflammon

# --- Monday job and Supabase function secrets. ---
# Service role. GitHub Actions secret and the Supabase function environment.
# Never a NEXT_PUBLIC_ value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Also set SUPABASE_ANON_KEY on the dispatch-send function so it can read the magic-link session.
SUPABASE_ANON_KEY=
# Resend. GitHub secret RESEND_API_KEY and the Supabase function secret of the same name.
RESEND_API_KEY=
# Verified sender, for example Inflammation Signal Monitor <briefing@example.com>.
NEWSLETTER_FROM=
# HMAC secret for unsubscribe links. Same value on the Monday job and the unsubscribe function.
UNSUBSCRIBE_HMAC_SECRET=
# Svix signing secret from the Resend webhook (whsec_...). Function secret only.
RESEND_WEBHOOK_SECRET=
# Turnstile secret. Test secret 1x0000000000000000000000000000000AA always passes.
# Function secret only.
TURNSTILE_SECRET_KEY=
# Where contact notifications go. Function secret and GitHub variable.
OWNER_NOTIFY_EMAIL=owner@example.com
# Public origin of the edge functions, used as List-Unsubscribe. GitHub variable FUNCTIONS_BASE.
FUNCTIONS_BASE=
# Dashboard origin printed in the email. GitHub variable SITE_URL.
SITE_URL=http://127.0.0.1:43123
# Physical address in the newsletter footer.
NEWSLETTER_POSTAL_ADDRESS=Your organization, street, city, region, postal code, country
# 1 sends without waiting for the owner. Empty waits for approval on /approve.
NEWSLETTER_AUTO_SEND=
# 1 forces a dry run. Empty also dry-runs the local server. Set to 0 on the
# Supabase functions and the GitHub variable only when a real send is intended.
NEWSLETTER_DRY_RUN=1
# Fine-grained GitHub token that can dispatch workflows. Function secret for dispatch-send.
GITHUB_DISPATCH_TOKEN=
# owner/repo. Function secret. GitHub Actions sets GITHUB_REPOSITORY itself.
GITHUB_REPOSITORY=
